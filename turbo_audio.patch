  ****************************************************************************/
 static void timer_delay_us(unsigned long microseconds)
 {
-    if (!timer_open)
+    struct timeval target, now;
+    
+    if (!timer_open || microseconds < 200)
         return;
     
-    timer_req->tr_node.io_Command = TR_ADDREQUEST;
-    timer_req->tr_time.tv_secs = microseconds / 1000000;
-    timer_req->tr_time.tv_micro = microseconds % 1000000;
-    DoIO((struct IORequest *)timer_req);
+    /* Compute absolute target time once at entry.
+     * All subsequent waits converge toward this target. */
+    GetSysTime(&target);
+    target.tv_micro += microseconds;
+    if (target.tv_micro >= 1000000)
+    {
+        target.tv_secs++;
+        target.tv_micro -= 1000000;
+    }
+    
+    /* On PiStorm/Emu68, DoIO round-trip through the interrupt controller
+     * costs 0.5-2ms. For short delays, the DoIO overhead exceeds the
+     * intended delay, causing frame jitter and audio underruns.
+     *
+     * Strategy: DoIO for the bulk (saves CPU vs pure busy-wait),
+     * then busy-wait the last ~2ms for precision. */
+    if (microseconds >= 4000)
+    {
+        timer_req->tr_node.io_Command = TR_ADDREQUEST;
+        timer_req->tr_time.tv_secs = 0;
+        timer_req->tr_time.tv_micro = microseconds - 2000;  /* leave 2ms for trim */
+        DoIO((struct IORequest *)timer_req);
+    }
+    
+    /* Busy-wait the remainder using GetSysTime (reads EClock, no interrupt) */
+    do {
+        GetSysTime(&now);
+    } while (now.tv_secs < target.tv_secs ||
+             (now.tv_secs == target.tv_secs && now.tv_micro < target.tv_micro));
 }
 
